<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LittleRun.Desktop</RootNamespace>
    <AssemblyName>LittleRun</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Product>LittleRun</Product>
    <Company>slcpunked</Company>
    <Copyright>Copyright (c) 2026 slcpunked. PolyForm Noncommercial 1.0.0.</Copyright>
    <!-- build.ps1 passes the version from pyproject.toml -->
    <Version Condition="'$(Version)' == ''">0.2.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Folder staged by build.ps1 (uv, backend wheel, prebuilt kernel, pinned requirements). -->
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)..\..\build\payload\</PayloadDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <!-- The chat UI ships inside the exe. -->
    <EmbeddedResource Include="ui\**\*" Exclude="ui\tests\**" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Remove="ui\**\*" />
  </ItemGroup>

  <!-- The backend payload ships inside the exe when it has been staged. Tests and a bare `dotnet build`
       work without it; the app then reports that the payload is missing. -->
  <ItemGroup Condition="Exists('$(PayloadDir)payload.json')">
    <EmbeddedResource Include="$(PayloadDir)**\*" LogicalName="payload/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LittleRun.Desktop.Tests" />
  </ItemGroup>

  <!-- The WebView2 package always references its WPF control; this WinForms app does not use it,
       and keeping it causes a WindowsBase version conflict. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
